# No .env or API key is needed for on-device AI. Run npm run setup:model once.
# Leave all three blank to use the downloaded CPU model and authored sample.
# Copy to .env, then set ALL three values to enable hosted AI.
# Example (verified against Groq's published model catalog; needs a Groq key):
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# HTTPS hosted APIs only. Keys stay on the Node server, never in the browser.
# Choose an open-weight model to satisfy the Week 4 challenge.
AI_TIMEOUT_MS=60000
PORT=4173
